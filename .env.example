# ── Django / Backend ──────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=laptop_mon
MYSQL_USER=laptop_mon
MYSQL_PASSWORD=laptop_mon_dev
MYSQL_ROOT_PASSWORD=rootpassword

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# ── MinIO / S3 ────────────────────────────────────────────────────────────────
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=screenshots
AWS_STORAGE_BUCKET_NAME=screenshots
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# ── Mail ──────────────────────────────────────────────────────────────────────
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False

# ── OIDC ──────────────────────────────────────────────────────────────────────
OIDC_CLIENT_ID=your-oidc-client-id
OIDC_CLIENT_SECRET=your-oidc-client-secret
OIDC_AUTHORITY=https://your-oidc-provider.example.com

# ── Agent ─────────────────────────────────────────────────────────────────────
AGENT_API_BASE_URL=http://localhost:8000
